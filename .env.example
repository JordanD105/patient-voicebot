# LiveKit Cloud project. The worker and the dialer both read these.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound trunk that places the call. `lk sip outbound list` prints the id.
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxx

# The ONE caller ID used for every test call. Submit this exact value.
# This is your number, not the number you are dialing.
SIP_CALLER_NUMBER=+1XXXXXXXXXX

# inference (default) uses LiveKit Inference: Deepgram STT, OpenAI LLM, Cartesia TTS.
# direct uses your own Deepgram, OpenAI, and Cartesia keys instead.
PIPELINE=inference
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Only used when PIPELINE=direct.
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=

# Set to 0 if the telephony noise filter fails to load.
NOISE_CANCELLATION=1

CALLS_DIR=calls
